<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Hardened runtime is switched on at signing time (codesign --options runtime).
         NO App Sandbox: the app must post input events and capture other apps' windows. -->
    <key>com.apple.security.automation.apple-events</key>
    <true/>
</dict>
</plist>
