#!/bin/sh
# MCP server launcher inside Ispyx.app: Contents/Resources/ispyx.
# An MCP client config only needs this path, e.g. /Applications/Ispyx.app/Contents/Resources/ispyx
# It runs `ispyx mcp`: a thin forwarder to the resident server that Ispyx.app runs (it opens the app first when
# that is not running). stdin/stdout stay the MCP stdio channel.
set -eu

# resolve symlinks so the bundle is found even when started through a link
SELF="$0"
while [ -L "$SELF" ]; do
  DIR="$(cd "$(dirname "$SELF")" && pwd)"
  SELF="$(readlink "$SELF")"
  case "$SELF" in
    /*) ;;
    *) SELF="$DIR/$SELF" ;;
  esac
done
RES="$(cd "$(dirname "$SELF")" && pwd)"

NODE="$RES/node/bin/node"
ENTRY="$RES/core/src/macos-entry.js"

if [ ! -x "$NODE" ] || [ ! -f "$ENTRY" ]; then
  echo "ispyx: the bundled Node or server is missing in $RES (damaged Ispyx.app?)" >&2
  exit 1
fi

# `ispyx update` / `ispyx quit` are commands; anything else is an MCP client starting the forwarder.
case "${1:-}" in
  update|quit) MODE="" ;;
  *) MODE="mcp" ;;
esac

# The bundled Node is universal, and macOS picks the slice of the parent: an MCP client running under Rosetta
# (an x86_64 Node or terminal on an Apple Silicon Mac) would get the Intel slice, emulated. Ask for arm64 there.
if [ "$(sysctl -n hw.optional.arm64 2>/dev/null)" = "1" ]; then
  exec arch -arm64 "$NODE" "$ENTRY" $MODE "$@"
fi
exec "$NODE" "$ENTRY" $MODE "$@"
