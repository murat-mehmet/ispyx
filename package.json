{
  "name": "ispyx",
  "version": "1.0.6",
  "description": "Local desktop-control MCP server: lets an AI use your keyboard, mouse and screen (windows, screenshots, clicks, typing, clipboard). stdio only, Windows and macOS.",
  "type": "module",
  "main": "src/server.js",
  "bin": {
    "ispyx": "src/server.js"
  },
  "files": [
    "src/",
    "README.md",
    "LICENSE",
    "config.example.json"
  ],
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "computer-use",
    "desktop-automation",
    "windows",
    "macos",
    "screenshot",
    "keyboard",
    "mouse",
    "claude"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/murat-mehmet/ispyx.git"
  },
  "bugs": {
    "url": "https://github.com/murat-mehmet/ispyx/issues"
  },
  "homepage": "https://github.com/murat-mehmet/ispyx#readme",
  "scripts": {
    "start": "node src/server.js",
    "test": "node test/unit.js",
    "smoke": "node test/smoke.js",
    "chrome-test": "node test/chrome.js",
    "instagram-test": "node test/instagram.js",
    "motion-test": "node test/motion.js",
    "stop-test": "node test/stop.js",
    "instances-test": "node test/instances.js",
    "hook-test": "node test/hook-life.js",
    "shutdown-test": "node test/shutdown-all.js",
    "scan-test": "node test/scan.js",
    "laser-test": "node test/laser.js",
    "radar-multi-test": "node test/radar-multi.js",
    "scan-multi-test": "node test/scan-multi.js",
    "auth-test": "node test/auth.js",
    "typing-test": "node test/typing.js",
    "core-test": "node test/core/effects-fake.js",
    "ipc-test": "node test/core/ipc-unix.js",
    "auth-panel-test": "node test/core/auth-panel.js",
    "resident-test": "node test/core/resident-fake.js",
    "darwin-test": "node test/darwin/client.js",
    "tray-test": "node test/win32-tray.js",
    "panel-test": "node test/panel.js"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "koffi": "^3.3.3",
    "zod": "^4.6.7"
  }
}
